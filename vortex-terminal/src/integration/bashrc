# Shell integration for Vortex's terminal panel. Started with `bash --init-file`, which replaces
# ~/.bashrc only (bash still reads /etc/bash.bashrc itself). Emits OSC 133 markers:
#   C: a command starts running      D;status: it finished      A: the prompt starts

if [ -f "$HOME/.bashrc" ]; then
    . "$HOME/.bashrc"
fi

if [ -z "$__vx_integration_loaded" ]; then
    __vx_integration_loaded=1

    # Runs first in PROMPT_COMMAND, to see the exit status of the command, and gives the same
    # status back to whatever runs next.
    __vx_precmd() {
        local __vx_status=$?
        __vx_at_prompt=
        printf '\e]133;D;%s\a\e]133;A\a' "$__vx_status"
        return "$__vx_status"
    }

    # Runs last in PROMPT_COMMAND: from here on, the DEBUG trap (old bash) is for the command.
    __vx_arm() {
        local __vx_status=$?
        __vx_at_prompt=1
        return "$__vx_status"
    }

    if [[ "$(declare -p PROMPT_COMMAND 2>/dev/null)" == "declare -a"* ]]; then
        PROMPT_COMMAND=(__vx_precmd "${PROMPT_COMMAND[@]}" __vx_arm)
    elif [ -n "$PROMPT_COMMAND" ]; then
        PROMPT_COMMAND="__vx_precmd;${PROMPT_COMMAND%;};__vx_arm"
    else
        PROMPT_COMMAND="__vx_precmd;__vx_arm"
    fi

    if ((BASH_VERSINFO[0] > 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] >= 4))); then
        # PS0 is printed after the line is read, before the command runs.
        PS0="${PS0}"'\e]133;C\a'
    else
        __vx_preexec() {
            local __vx_status=$?
            if [ -n "$__vx_at_prompt" ] && [ -z "$COMP_LINE" ]; then
                __vx_at_prompt=
                printf '\e]133;C\a'
            fi
            return "$__vx_status"
        }
        trap '__vx_preexec' DEBUG
    fi

    # The prompt ends: the user types the command.
    PS1="${PS1}"'\[\e]133;B\a\]'
fi
